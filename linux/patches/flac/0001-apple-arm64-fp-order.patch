+/* The macOS arm64 encoder dispatches to the NEON reverse-order kernel.
+ * Each lane is an independent binary64 fused accumulation; retaining the
+ * lane order matters even on machines with a different vector width. */
+static void apple_autocorrelation(const FLAC__real data[], uint32_t data_len,
+	uint32_t lag, double autoc[], uint32_t width)
+{
+	double history[14] = { 0.0 };
+	double sums[14] = { 0.0 };
+	uint32_t i, j;
+	(void)lag;
+	FLAC__ASSERT(lag <= width);
+	for(i = data_len; i != 0; ) {
+		const double sample = data[--i];
+		for(j = width - 1; j != 0; --j)
+			history[j] = history[j - 1];
+		history[0] = sample;
+		for(j = 0; j < width; ++j)
+			sums[j] = fma(sample, history[j], sums[j]);
+	}
+	for(j = 0; j < width; ++j)
+		autoc[j] = sums[j];
+}
+
+void FLAC__lpc_compute_autocorrelation_apple_lag_8(const FLAC__real data[], uint32_t len, uint32_t lag, double autoc[])
+{
+	apple_autocorrelation(data, len, lag, autoc, 8);
+}
+
+void FLAC__lpc_compute_autocorrelation_apple_lag_10(const FLAC__real data[], uint32_t len, uint32_t lag, double autoc[])
+{
+	apple_autocorrelation(data, len, lag, autoc, 10);
+}
+
+void FLAC__lpc_compute_autocorrelation_apple_lag_14(const FLAC__real data[], uint32_t len, uint32_t lag, double autoc[])
+{
+	apple_autocorrelation(data, len, lag, autoc, 14);
